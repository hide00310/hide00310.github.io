---
const today = new Date();
---

<style>
  footer {
    padding: 2em 1em 6em 1em;
    background: linear-gradient(var(--gray-gradient)) no-repeat;
    color: rgb(var(--gray));
    text-align: center;
  }
  .social-links {
    display: flex;
    justify-content: center;
    gap: 1em;
    margin-top: 1em;
  }
  .social-links a {
    text-decoration: none;
    color: rgb(var(--gray));
  }
  .social-links a:hover {
    color: rgb(var(--gray-dark));
  }

.link-item {
	display: flex;
	align-items: center;
	gap: 0.75em;
	padding: 0.75em 1em;
	border: 1px solid rgb(var(--gray-light));
	border-radius: 8px;
	text-decoration: none;
	color: rgb(var(--gray-dark));
	background: #fff;
	transition:
		box-shadow 0.2s ease,
		transform 0.2s ease;
}
.link-item:hover {
	box-shadow: var(--box-shadow);
	transform: translateY(-2px);
}
.link-icon {
	width: 24px;
	height: 24px;
	margin: 0;
	border-radius: 4px;
	flex-shrink: 0;
}
.link-label {
	font-weight: 700;
	color: rgb(var(--black));
}  
</style>

<footer>
  &copy; {today.getFullYear()} hide00310. All rights reserved.
  <div class="social-links">
    <a
      class="link-item"
      href="https://github.com/hide00310"
      target="_blank"
      rel="noopener noreferrer"
    >
      <img
        class="link-icon"
        src="https://www.google.com/s2/favicons?sz=64&domain=github.com"
        alt=""
      />
      <span class="link-label">GitHub</span>
    </a>
    <a
      class="link-item"
      href="https://dev.to/hide00310"
      target="_blank"
      rel="noopener noreferrer"
    >
      <img
        class="link-icon"
        src="https://www.google.com/s2/favicons?sz=64&domain=dev.to"
        alt=""
      />
      <span class="link-label">dev.to</span>
    </a>
    <a
      class="link-item"
      href="https://zenn.dev/hide00310"
      target="_blank"
      rel="noopener noreferrer"
    >
      <img
        class="link-icon"
        src="https://www.google.com/s2/favicons?sz=64&domain=zenn.dev"
        alt=""
      />
      <span class="link-label">Zenn</span>
    </a>
    <a
      class="link-item"
      href="https://x.com/hide00310"
      target="_blank"
      rel="noopener noreferrer"
    >
      <img
        class="link-icon"
        src="https://www.google.com/s2/favicons?sz=64&domain=x.com"
        alt=""
      />
      <span class="link-label">X</span>
    </a>
    <a
      class="link-item"
      href="https://www.youtube.com/@hide00310"
      target="_blank"
      rel="noopener noreferrer"
    >
      <img
        class="link-icon"
        src="https://www.google.com/s2/favicons?sz=64&domain=youtube.com"
        alt=""
      />
      <span class="link-label">Youtube</span>
    </a>
  </div>
</footer>
